---
import Reading from './Reading.astro';
import Icon from './Icon.astro';
import simulationCopy from '../simulations.json';
import { languageFor, settings, type PageInfo } from '../lib/catalog';
interface Props { page: PageInfo; practice: boolean; simulationTopic: string; }
const { page, practice, simulationTopic } = Astro.props;
const { ui, href } = languageFor(page.locale);
const simulationText = simulationCopy[page.locale];
---
<div class="lesson-close">
  <Reading locale={page.locale} source={page.source} />
  <nav class="lesson-followups" aria-label={ui.continueLearning}>
    {practice && <a class="lesson-followup" data-tone="blue" href={`${href.simulations}#${simulationTopic}`}>
      <Icon name="workflow" size={20} />
      <span><strong>{simulationText.open}</strong><span>{simulationText.relatedText}</span></span>
      <Icon name="arrow" size={18} />
    </a>}
    <a class="lesson-followup" data-tone="green" href={href.learningPath}>
      <Icon name="compass" size={20} />
      <span><strong>{ui.chooseNextLesson}</strong><span>{ui.chooseNextLessonHint}</span></span>
      <Icon name="arrow" size={18} />
    </a>
  </nav>
  {page.source && <details class="document-resources">
    <summary><Icon name="code" size={18} />{ui.documentResources}</summary>
    <p>{ui.originalNotice}</p>
    <nav class="document-actions" aria-label={ui.source}>
      <a href={`${href.repository}?path=${encodeURIComponent(page.source)}`}><Icon name="file" size={16} />{ui.source}</a>
      <a href={`https://github.com/${settings.repository}/edit/main/${page.source}`}><Icon name="repository" size={16} />{ui.edit} <span aria-hidden="true">↗</span></a>
    </nav>
  </details>}
</div>
