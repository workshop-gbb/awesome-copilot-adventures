---
import { languageFor, labelFor, alternateUrls, locales, counts, type Locale } from '../lib/catalog';
import Discovery from './Discovery.astro';
import Reading from './Reading.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { ui, href } = languageFor(locale);
const alternates = alternateUrls('/');
const stages = [
  { id: 'ask', name: 'Ask', goal: ui.askGoal, artifact: ui.askArtifact },
  { id: 'plan', name: 'Plan', goal: ui.planGoal, artifact: ui.planArtifact },
  { id: 'agent', name: 'Agent', goal: ui.agentGoal, artifact: ui.agentArtifact },
  { id: 'review', name: ui.reviewStage, goal: ui.reviewGoal, artifact: ui.reviewArtifact },
  { id: 'evidence', name: ui.evidenceStage, goal: ui.evidenceGoal, artifact: ui.evidenceArtifact }
];
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{ui.heroEyebrow}</p>
      <h1>{ui.heroTitle.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</h1>
      <p class="hero-description">{ui.heroDescription}</p>
      <div class="hero-actions">
        <a class="button button-light" href={href.start}>{ui.start} <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href={href.repository}>{ui.heroSecondary} <span aria-hidden="true">→</span></a>
      </div>
      <p class="workflow-line">{ui.heroNote}</p>
      <div class="hero-languages">
        <span>{ui.languageAccess}</span>
        <nav aria-label={ui.languages}>
          {locales.map(language => <a href={alternates[language]} data-locale={language} lang={language} hreflang={language} aria-current={language === locale ? 'page' : undefined}>{labelFor(language, 'language')}</a>)}
        </nav>
      </div>
    </div>
    <aside class="hero-panel">
      <div class="panel-top"><span class="mono">ACA / 01</span><span class="panel-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span></div>
      <h2>{ui.workflowExplore}</h2>
      <div class="workflow-steps">
        {stages.map((stage, index) => (
          <details name="workflow" data-workflow-step={stage.id} open={index === 0}>
            <summary><span class="stage-index">0{index + 1}</span><span>{stage.name}</span><span class="stage-toggle" aria-hidden="true">+</span></summary>
            <div class="stage-content"><p>{stage.goal}</p><small>{ui.deliverable}</small><p class="stage-artifact">{stage.artifact}</p></div>
          </details>
        ))}
      </div>
      <p class="workflow-disclaimer">{ui.workflowNote}</p>
    </aside>
  </div>
  <div class="container hero-stats">
    <a href={href.adventures} aria-label={`${counts.adventureCount} ${ui.adventures}`}><strong data-counter={counts.adventureCount}>{counts.adventureCount}</strong><span>{ui.adventures}</span></a>
    <a href={href.handsOn} aria-label={`${counts.handsOnCount} ${ui['hands-on']}`}><strong data-counter={counts.handsOnCount}>{counts.handsOnCount}</strong><span>{ui['hands-on']}</span></a>
    <a href={href.library} aria-label={`${counts.documentCount} ${ui.guides}`}><strong data-counter={counts.documentCount}>{counts.documentCount}</strong><span>{ui.guides}</span></a>
    <a href={href.repository} aria-label={`${counts.sourceCount} ${ui.sourceCount}`}><strong data-counter={counts.sourceCount}>{counts.sourceCount}</strong><span>{ui.sourceCount}</span></a>
  </div>
</section>
<section class="section container discovery-section">
  <div class="section-heading" data-reveal><p class="eyebrow">{ui.guides}</p><h2>{ui.libraryTitle}</h2><p>{ui.libraryDescription}</p></div>
  <Reading locale={locale} />
  <Discovery locale={locale} compact />
</section>
<section class="section container">
  <div class="section-heading"><p class="eyebrow">{ui.tracksEyebrow}</p><h2>{ui.tracksTitle}</h2></div>
  <div class="track-grid">
    <a class="track-card accent-blue" href={href.adventures}><span class="card-index">01 / {ui.adventures}</span><h3>{ui.adventures}</h3><p>{ui.adventureDescription}</p><span class="card-arrow" aria-hidden="true">↗</span></a>
    <a class="track-card accent-green" href={href.handsOn}><span class="card-index">02 / {ui['hands-on']}</span><h3>{ui['hands-on']}</h3><p>{ui.handsOnDescription}</p><span class="card-arrow" aria-hidden="true">↗</span></a>
    <a class="track-card accent-yellow" href={href.harness}><span class="card-index">03 / {ui.guides}</span><h3>{ui.guides}</h3><p>{ui.guideDescription}</p><span class="card-arrow" aria-hidden="true">↗</span></a>
    <a class="track-card accent-red" href={href.repository}><span class="card-index">04 / {ui.source}</span><h3>{ui.repository}</h3><p>{ui.sourceDescription}</p><span class="card-arrow" aria-hidden="true">↗</span></a>
  </div>
</section>
<section class="section progression-section">
  <div class="container">
    <div class="section-heading"><p class="eyebrow">{ui.curriculumEyebrow}</p><h2>{ui.curriculumTitle}</h2></div>
    <ol class="progression-grid">
      <li><span class="step-number">01</span><h3>{ui.foundations}</h3><p>{ui.foundationsText}</p></li>
      <li><span class="step-number">02</span><h3>{ui.engineering}</h3><p>{ui.engineeringText}</p></li>
      <li><span class="step-number">03</span><h3>{ui.coordination}</h3><p>{ui.coordinationText}</p></li>
      <li><span class="step-number">04</span><h3>{ui.surfaces}</h3><p>{ui.surfacesText}</p></li>
    </ol>
    <a class="text-link" href={href.curriculum}>{ui.curriculum} <span aria-hidden="true">→</span></a>
  </div>
</section>
