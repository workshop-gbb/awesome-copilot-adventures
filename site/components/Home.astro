---
import { languageFor, counts, type Locale } from '../lib/catalog';
import Discovery from './Discovery.astro';
import LearningPath from './LearningPath.astro';
import { renderScene } from '../lib/scenes';
import StudioPreview from './StudioPreview.astro';
import AdventureFilms from './AdventureFilms.astro';
import Icon from './Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { ui, href } = languageFor(locale);
const workflowScene = renderScene('evidence-workflow', locale, { kicker: ui.sceneKicker, replay: ui.sceneReplay }, 'home-workflow');
const stages = [
  { id: 'ask', name: 'Ask', goal: ui.askGoal, artifact: ui.askArtifact },
  { id: 'plan', name: 'Plan', goal: ui.planGoal, artifact: ui.planArtifact },
  { id: 'agent', name: 'Agent', goal: ui.agentGoal, artifact: ui.agentArtifact },
  { id: 'review', name: ui.reviewStage, goal: ui.reviewGoal, artifact: ui.reviewArtifact },
  { id: 'evidence', name: ui.evidenceStage, goal: ui.evidenceGoal, artifact: ui.evidenceArtifact }
] as const;
const pathway = [
  { tone: 'blue', icon: 'compass', label: ui.prerequisites, url: href.prerequisites },
  { tone: 'green', icon: 'spark', label: ui.start, url: href.start },
  { tone: 'yellow', icon: 'steps', label: ui.learningOrder, url: href.learningPath },
  { tone: 'red', icon: 'download', label: ui.learnerKits, url: href.downloads }
] as const;
const stats = [
  { tone: 'blue', icon: 'map', value: counts.adventureCount, label: ui.adventures, url: href.adventures },
  { tone: 'green', icon: 'terminal', value: counts.handsOnCount, label: ui['hands-on'], url: href.handsOn },
  { tone: 'yellow', icon: 'book', value: counts.guideCount, label: ui.guides, url: href.library },
  { tone: 'red', icon: 'repository', value: counts.sourceCount, label: ui.sourceCount, url: href.repository }
] as const;
---
<section class="hero he-inverse">
  <div class="hero-aurora" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{ui.heroEyebrow}</p>
      <h1>{ui.heroTitle.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</h1>
      <p class="hero-description">{ui.heroDescription}</p>
      <div class="hero-actions">
        <a class="button button-light" href={href.start}>{ui.start} <Icon name="spark" size={16} /></a>
        <a class="button button-outline" href={href.downloads}>{ui.learnerKits} <Icon name="download" size={16} /></a>
      </div>
      <p class="workflow-line">{ui.heroNote}</p>
    </div>
    <aside class="hero-panel">
      <div class="panel-top"><span class="mono">ACA / 01</span><span class="panel-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span></div>
      <h2>{ui.workflowExplore}</h2>
      <div class="workflow-steps">
        {stages.map((stage, index) => (
          <details name="workflow" data-workflow-step={stage.id} open={index === 0}>
            <summary><span class="stage-index">0{index + 1}</span><span>{stage.name}</span><span class="stage-toggle" aria-hidden="true">+</span></summary>
            <div class="stage-content"><p>{stage.goal}</p><small>{ui.deliverable}</small><p class="stage-artifact">{stage.artifact}</p></div>
          </details>
        ))}
      </div>
      <p class="workflow-disclaimer">{ui.workflowNote}</p>
    </aside>
  </div>
  <div class="container hero-stats">
    {stats.map(stat => (
      <a href={stat.url} data-tone={stat.tone} aria-label={`${stat.value} ${stat.label}`}>
        <Icon name={stat.icon} size={18} />
        <strong data-counter={stat.value}>{stat.value}</strong>
        <span>{stat.label}</span>
      </a>
    ))}
  </div>
</section>
<section class="section container pathway-section">
  <div class="section-heading" data-tone="green"><p class="eyebrow"><Icon name="compass" size={14} />{ui.learningNavigation}</p><h2>{ui.firstVisit}</h2><p>{ui.firstVisitText}</p></div>
  <nav class="pathway-grid" aria-label={ui.learningNavigation}>
    {pathway.map((step, index) => (
      <a class="pathway-card" href={step.url} data-tone={step.tone}>
        <Icon name={step.icon} size={22} tone={step.tone} chip />
        <span class="pathway-index">{String(index).padStart(2, '0')}</span>
        <span class="pathway-label">{step.label}</span>
        <Icon name="arrow" size={16} />
      </a>
    ))}
  </nav>
</section>
<section class="section container workflow-section" aria-label={ui.workflowExplore}>
  <Fragment set:html={workflowScene} />
</section>
<LearningPath locale={locale} />
<AdventureFilms locale={locale} />
<StudioPreview locale={locale} />
<section class="section container discovery-section">
  <div class="section-heading" data-tone="yellow" data-reveal><p class="eyebrow"><Icon name="book" size={14} />{ui.guides}</p><h2>{ui.libraryTitle}</h2><p>{ui.libraryDescription}</p></div>
  <Discovery locale={locale} compact />
</section>
