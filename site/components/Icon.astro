---
/*
 * Shared line-icon system. Every glyph is drawn on a 24px grid with a 1.7px round stroke so the
 * set reads as one family beside Inter and JetBrains Mono. The first block is the original site set;
 * the second block ports the deck skill's 24px line icons (visual_layer.py) so lessons, scenes and
 * diagrams can name concepts (hook, plug, branch, test, evidence) with one vocabulary.
 * One icon keeps one meaning across the site; decorative uses stay aria-hidden.
 */
import { ICON_PATHS, ICON_FRAGMENTS, type IconName } from '../lib/icons';
export type { IconName };
export type IconTone = 'blue' | 'green' | 'yellow' | 'red' | 'ink';
interface Props { name: IconName; size?: number; tone?: IconTone; chip?: boolean; label?: string; }
const { name, size = 20, tone, chip = false, label } = Astro.props;
const glyph = ICON_PATHS[name];
const fragment = ICON_FRAGMENTS[name];
if (!glyph && !fragment) throw new Error(`Unknown icon: ${name}`);
const decorative = !label;
---
{chip ? (
  <span class="he-icon-chip" data-tone={tone} aria-hidden={decorative ? 'true' : undefined} role={decorative ? undefined : 'img'} aria-label={label}>
    <svg class="he-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      {glyph ? glyph.map(d => <path d={d} />) : <Fragment set:html={fragment} />}
    </svg>
  </span>
) : (
  <svg class="he-icon" width={size} height={size} viewBox="0 0 24 24" data-tone={tone} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden={decorative ? 'true' : undefined} role={decorative ? undefined : 'img'} aria-label={label} focusable="false">
    {glyph ? glyph.map(d => <path d={d} />) : <Fragment set:html={fragment} />}
  </svg>
)}
