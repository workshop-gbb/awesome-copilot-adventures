---
import { languageFor, labelFor, locales, type PageInfo } from '../lib/catalog';
import Icon from './Icon.astro';
interface Props { page: PageInfo; }
const { page } = Astro.props;
const { ui, href } = languageFor(page.locale);
---
<progress class="reading-progress" id="reading-progress" max="100" value="0" aria-label={ui.readingProgress}></progress>
<header class="masthead">
  <div class="container masthead-inner">
    <a class="brand" href={href.home} aria-label={`Awesome Copilot Adventures · ${ui.home}`}>
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span>Awesome Copilot<strong>Adventures</strong></span>
    </a>
    <button class="menu-button quiet-button" type="button" data-site-control hidden aria-expanded="false" aria-controls="main-navigation"><span class="menu-label">{ui.menu}</span><Icon name="menu" /></button>
    <nav id="main-navigation" class="main-navigation" aria-label={ui.navigation}>
      <a href={href.prerequisites} aria-current={page.route === '/prerequisites/' ? 'page' : undefined}>{ui.prerequisites}</a>
      <a href={href.adventures} aria-current={page.group === 'adventures' ? 'true' : undefined}>{ui.adventures}</a>
      <a href={href.handsOn} aria-current={page.group === 'hands-on' ? 'true' : undefined}>{ui.navHandsOn}</a>
      <a href={href.simulations} aria-current={page.route === '/simulations/' ? 'page' : undefined}>{ui.navStudio}</a>
      <a href={href.library} aria-current={page.kind === 'library' ? 'page' : undefined}>{ui.guides}</a>
      <a href={href.repository} aria-current={page.kind === 'repository' ? 'page' : undefined}>{ui.repository}</a>
    </nav>
    <div class="masthead-tools">
      <button class="search-trigger quiet-button" type="button" data-site-control hidden aria-label={ui.search}><Icon name="search" /></button>
      <div class="locale-control">
        <span class="locale-label">{ui.languageLabel}</span>
        <nav class="locale-switch" aria-label={ui.languages}>
          {locales.map(locale => (
            <a href={page.alternates[locale]} lang={locale} hreflang={locale} data-locale={locale} aria-label={labelFor(locale, 'language')} aria-current={locale === page.locale ? 'page' : undefined}>{locale.toUpperCase()}</a>
          ))}
        </nav>
      </div>
      <button class="theme-toggle quiet-button" type="button" data-site-control hidden aria-pressed="false" aria-label={ui.theme}><Icon name="theme" /></button>
      <a class="header-cta" href={href.start}>{ui.start} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>
