---
import { languageFor, type PageInfo } from '../lib/catalog';
interface Props { page: PageInfo; }
const { page } = Astro.props;
const { ui, href } = languageFor(page.locale);
---
<div class="identity-rule" aria-hidden="true"></div>
<header class="masthead">
  <div class="container masthead-inner">
    <a class="brand" href={href.home} aria-label={`Awesome Copilot Adventures · ${ui.home}`}>
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span>Awesome Copilot<strong>Adventures</strong></span>
    </a>
    <button class="menu-button quiet-button" type="button" aria-expanded="false" aria-controls="main-navigation">{ui.menu} <span aria-hidden="true">☰</span></button>
    <nav id="main-navigation" class="main-navigation" aria-label={ui.navigation}>
      <a href={href.adventures} aria-current={page.group === 'adventures' ? 'true' : undefined}>{ui.adventures}</a>
      <a href={href.handsOn} aria-current={page.group === 'hands-on' ? 'true' : undefined}>{ui['hands-on']}</a>
      <a href={href.library}>{ui.guides}</a>
      <a href={href.repository} aria-current={page.kind === 'repository' ? 'page' : undefined}>{ui.repository}</a>
    </nav>
    <div class="masthead-tools">
      <button class="search-trigger quiet-button" type="button" aria-label={ui.search}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg></button>
      <nav class="locale-switch" aria-label={ui.languages}>
        {Object.entries(page.alternates).map(([locale, url]) => (
          <a href={url} lang={locale} hreflang={locale} data-locale={locale} aria-current={locale === page.locale ? 'page' : undefined}>{locale.toUpperCase()}</a>
        ))}
      </nav>
      <button class="theme-toggle quiet-button" type="button" aria-pressed="false" aria-label={ui.theme}><span aria-hidden="true">◐</span></button>
      <a class="header-cta" href={href.start}>{ui.start} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>
