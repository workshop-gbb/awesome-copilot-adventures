---
import { languageFor, labelFor, locales, settings, counts, type PageInfo } from '../lib/catalog';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import maintainerArt from '../../assets/images/general/paula-gbb-image.jpg';
import simulationCopy from '../simulations.json';
interface Props { page: PageInfo; }
const { page } = Astro.props;
const { ui, href } = languageFor(page.locale);
---
<footer class="site-footer he-inverse">
  <div class="container footer-shell">
    <div class="footer-heading">
      <div class="footer-identity">
        <a class="footer-brand" href={href.home} aria-label={`Awesome Copilot Adventures · ${ui.home}`}>
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span>Awesome Copilot<strong>Adventures</strong></span>
        </a>
        <p>MIT · {ui.footerAbout}</p>
      </div>
      <nav class="footer-languages" aria-label={ui.footerLanguages}>
        {locales.map(locale => (
          <a href={page.alternates[locale]} data-locale={locale}
            lang={labelFor(locale, 'languageTag')} hreflang={labelFor(locale, 'languageTag')}
            aria-current={locale === page.locale ? 'page' : undefined}>
            {labelFor(locale, 'language')}
          </a>
        ))}
      </nav>
    </div>

    <nav class="footer-navigation" aria-label={ui.guides}>
      <a href={href.simulations}>{simulationCopy[page.locale].title}</a>
      <a href={href.glossary}>{ui.glossary}</a>
      <a href={href.status}>{ui.status}</a>
      <a href={href.design}>{ui.design}</a>
      <a href={href.support}>{ui.support}</a>
      <a href={`https://github.com/${settings.repository}`}>GitHub<Icon name="arrow" size={14} /></a>
    </nav>

    <details class="footer-details">
      <summary>{ui.footerDetails}</summary>
      <div class="footer-credit-grid">
        <section class="footer-credits" aria-labelledby="footer-credits-title">
          <h2 id="footer-credits-title">{ui.credits}</h2>
          <ul>
            <li><a href="https://github.com/microsoft/CopilotAdventures">microsoft/CopilotAdventures</a><span>{ui.adventureCredit}</span></li>
            <li><a href="https://github.com/MicrosoftLearning/mslearn-github-copilot-dev">MicrosoftLearning/mslearn-github-copilot-dev</a><span>{ui.handsOnCredit}</span></li>
          </ul>
          <p>{ui.creditsEvolution}</p>
          <a class="footer-credit-link" href={href.credits}>{ui.fullCredits}</a>
        </section>
        <section class="footer-colophon" aria-labelledby="footer-fonts-title">
          <h2 id="footer-fonts-title">{ui.fontLicenses}</h2>
          <nav class="footer-fonts" aria-labelledby="footer-fonts-title">
            <a href={`${settings.base}/assets/site/fonts/OFL-Inter.txt`}>Inter</a>
            <a href={`${settings.base}/assets/site/fonts/OFL-JetBrains-Mono.txt`}>JetBrains Mono</a>
          </nav>
          <p>{ui.footerText}</p>
          <a href={settings.maintainer.website}>agenticdevopsplatform.ai</a>
          <p class="footer-build">{ui.footerBuild} <code>{counts.revision}</code></p>
        </section>
      </div>
    </details>

    <div class="footer-bottom">
      <address class="footer-author">
        <Image src={maintainerArt} width={48} height={48} alt="" format="webp" loading="lazy" decoding="async" />
        <div>
          <span>{ui.maintainedBy}</span>
          <a href={settings.maintainer.profile}><strong>{settings.maintainer.name}</strong><span>{settings.maintainer.handle}</span></a>
        </div>
      </address>
      <a class="footer-back-top" href="#top">{ui.backTop}<Icon name="arrow" size={18} /></a>
    </div>
  </div>
</footer>
