---
import { languageFor, counts, type Locale } from '../lib/catalog';
import Discovery from './Discovery.astro';
import Reading from './Reading.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const { ui } = languageFor(locale);
---
<div class="section-heading">
  <p class="eyebrow">{counts.documentCount} / {ui.guides}</p>
  <h1>{ui.libraryTitle}</h1>
  <p>{ui.libraryDescription}</p>
</div>
<Reading locale={locale} />
<Discovery locale={locale} />
