---
import { counts, languageFor, type Locale } from '../lib/catalog';
import labels from '../adventure-films.json';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const text = labels[locale];
const { href } = languageFor(locale);
const descriptions: Record<string, { title: string; description: string; posterAlt: string }> = text.films;
const films = counts.adventureFilms.map(film => {
  const description = descriptions[film.id];
  if (!description) throw new Error(`Missing adventure film copy: ${locale}/${film.id}`);
  return { ...film, ...description };
});
---
<section
  class="adventure-films" aria-labelledby="adventure-films-title" data-adventure-films
  data-video-error={text.error} data-video-playing={text.playing} data-video-paused={text.paused}
>
  <div class="container">
    <div class="film-heading">
      <div class="section-heading">
        <p class="eyebrow">{text.eyebrow}</p>
        <h2 id="adventure-films-title">{text.title}</h2>
        <p>{text.description}</p>
      </div>
      <p class="film-motion-note" id="film-motion-note">{text.motion}</p>
    </div>
    <div class="film-grid">
      {films.map((film, index) => (
        <figure class:list={['film-card', index === 0 && 'film-card-featured']} data-adventure-film>
          <button
            class="film-viewport" type="button" data-film-trigger aria-pressed="false"
            aria-label={`${text.play}: ${film.title}`}
            aria-describedby={`${film.id}-description film-motion-note`}
          >
            <img src={film.poster} width={film.width} height={film.height} alt={film.posterAlt} loading="lazy" decoding="async" data-film-poster />
            <video
              data-adventure-video data-video-src={film.url} poster={film.poster}
              width={film.width} height={film.height} loop muted playsinline preload="none"
              aria-hidden="true"
            ></video>
            <span class="film-hover-cue" aria-hidden="true">{text.hover}</span>
          </button>
          <figcaption>
            <p class="film-duration"><span>0{index + 1}</span><span>{film.duration} {text.silent}</span></p>
            <h3 id={`${film.id}-title`}>{film.title}</h3>
            <p id={`${film.id}-description`}>{film.description}</p>
            <div class="film-links">
              <a href={film.url}>{text.download}</a>
              <a href={`${href.repository}?path=${encodeURIComponent(film.original)}`}>{text.original}</a>
            </div>
            <p class="film-status" role="status" data-film-status></p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .adventure-films { --film-rule: #383936; padding-block: clamp(72px, 8vw, 120px); overflow: hidden; background: #101110; color: #f4f4ef; }
  .film-heading { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(280px, .65fr); gap: clamp(32px, 7vw, 112px); align-items: end; margin-bottom: 44px; }
  .film-heading .section-heading { max-width: 760px; margin: 0; }
  .film-heading .eyebrow { color: #a9aaa5; }
  .film-heading h2 { color: #fff; }
  .film-heading .section-heading p:not(.eyebrow), .film-motion-note { color: #b9bab5; }
  .film-motion-note { max-width: 52ch; margin: 0; padding-top: 18px; border-top: 1px solid var(--film-rule); font: 12px/1.75 var(--mono); }
  .film-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(340px, .8fr); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .film-card { display: grid; grid-template-columns: minmax(160px, .9fr) minmax(0, 1fr); gap: 22px; min-width: 0; margin: 0; padding-top: 20px; border-top: 1px solid var(--film-rule); }
  .film-card-featured { grid-row: 1 / 3; display: flex; flex-direction: column; padding: 0 20px 0 0; border-top: 0; border-right: 1px solid var(--film-rule); }
  .film-viewport { position: relative; display: grid; aspect-ratio: 16 / 9; min-width: 0; padding: 0; overflow: hidden; border: 0; border-radius: 2px; background: #050505; color: #fff; text-align: left; }
  .film-viewport img, .film-viewport video { grid-area: 1 / 1; display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity .35s var(--ease), transform .7s var(--ease); }
  .film-viewport video { opacity: 0; }
  .film-card[data-playing="true"] .film-viewport img { opacity: 0; transform: scale(1.015); }
  .film-card[data-playing="true"] .film-viewport video { opacity: 1; }
  .film-hover-cue { position: absolute; left: 14px; bottom: 14px; z-index: 1; padding: 6px 9px; background: rgb(12 13 12 / 76%); color: #efefeb; font: 9px/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; backdrop-filter: blur(8px); transition: opacity .2s; }
  .film-card[data-playing="true"] .film-hover-cue { opacity: 0; }
  .film-card figcaption { min-width: 0; }
  .film-card h3 { margin: 14px 0 10px; color: #fff; font-size: 19px; line-height: 1.3; font-weight: 520; letter-spacing: -.025em; }
  .film-card-featured h3 { margin-top: 18px; font-size: clamp(24px, 2.4vw, 36px); }
  .film-card figcaption > p:not(.film-duration, .film-status) { margin: 0; color: #b9bab5; font-size: 13px; line-height: 1.7; }
  .film-card-featured figcaption > p:not(.film-duration, .film-status) { max-width: 66ch; font-size: 15px; }
  .film-duration { display: flex; justify-content: space-between; gap: 16px; margin: 0; color: #91928e; font: 10px/1.6 var(--mono); letter-spacing: .05em; text-transform: uppercase; }
  .film-card-featured .film-duration { margin-top: 20px; }
  .film-status { margin: 10px 0 0; color: #ffb5b6; font-size: 12px; }
  .film-status:empty { display: none; }
  .film-links { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 14px; font: 10px/1.5 var(--mono); }
  .film-links a { display: inline-flex; align-items: center; min-height: 32px; color: #d9dad5; text-decoration-color: #5b5c58; }
  @media (max-width: 1000px) {
    .film-heading { grid-template-columns: 1fr; }
    .film-grid { grid-template-columns: 1fr; grid-template-rows: auto; }
    .film-card, .film-card-featured { grid-row: auto; display: grid; grid-template-columns: minmax(240px, .9fr) minmax(0, 1fr); padding: 20px 0 0; border-top: 1px solid var(--film-rule); border-right: 0; }
    .film-card-featured h3 { font-size: 24px; }
  }
  @media (max-width: 680px) {
    .adventure-films { padding-block: 64px; }
    .film-card, .film-card-featured { display: flex; flex-direction: column; gap: 18px; }
    .film-heading { margin-bottom: 30px; }
    .film-motion-note { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .film-hover-cue { display: none; }
  }
</style>
