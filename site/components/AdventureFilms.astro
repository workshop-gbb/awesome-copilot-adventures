---
import { counts, languageFor, type Locale } from '../lib/catalog';
import labels from '../adventure-films.json';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const text = labels[locale];
const { href } = languageFor(locale);
const descriptions: Record<string, { title: string; description: string; posterAlt: string }> = text.films;
const films = counts.adventureFilms.map(film => {
  const description = descriptions[film.id];
  if (!description) throw new Error(`Missing adventure film copy: ${locale}/${film.id}`);
  return { ...film, ...description };
});
---
<section class="adventure-films" aria-labelledby="adventure-films-title" data-adventure-films data-video-error={text.error}>
  <div class="section-heading">
    <p class="eyebrow">{text.eyebrow}</p>
    <h2 id="adventure-films-title">{text.title}</h2>
    <p>{text.description}</p>
  </div>
  <p class="film-motion-note" id="film-motion-note">{text.motion}</p>
  <div class="film-grid">
    {films.map(film => (
      <figure class="film-card" data-adventure-film>
        <div class="film-viewport">
          <img src={film.poster} width={film.width} height={film.height} alt={film.posterAlt} loading="lazy" decoding="async" data-film-poster />
          <video
            data-adventure-video data-video-src={film.url} poster={film.poster}
            width={film.width} height={film.height} controls muted playsinline preload="none" hidden
            aria-labelledby={`${film.id}-title`} aria-describedby={`${film.id}-description film-motion-note`}
          ></video>
        </div>
        <figcaption>
          <p class="film-duration">{film.duration} {text.silent}</p>
          <h3 id={`${film.id}-title`}>{film.title}</h3>
          <p id={`${film.id}-description`}>{film.description}</p>
        </figcaption>
        <div class="film-controls">
          <button class="button button-primary" type="button" data-film-play hidden>{text.play}</button>
          <button class="button" type="button" data-film-still hidden>{text.still}</button>
        </div>
        <p class="film-status" role="status" data-film-status></p>
        <div class="film-links">
          <a href={film.url}>{text.download}</a>
          <a href={`${href.repository}?path=${encodeURIComponent(film.original)}`}>{text.original}</a>
        </div>
      </figure>
    ))}
  </div>
</section>

<style>
  .adventure-films { margin-block: 48px; }
  .film-motion-note { color: var(--ink-2); font-size: 14px; max-width: 80ch; }
  .film-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); gap: 20px; margin-top: 28px; }
  .film-card { display: flex; flex-direction: column; min-width: 0; margin: 0; padding: 16px; border: 1px solid var(--rule-2); border-radius: var(--he-radius-card); background: var(--paper); }
  .film-viewport { aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; background: #141414; }
  .film-viewport img, .film-viewport video { display: block; width: 100%; height: 100%; object-fit: contain; }
  .film-card h3 { font-size: 19px; line-height: 1.35; font-weight: 550; margin-block: 12px; }
  .film-card figcaption > p:not(.film-duration) { color: var(--ink-2); font-size: 14px; line-height: 1.7; }
  .film-duration { margin-top: 18px; font: 12px/1.6 var(--mono); color: var(--ink-3); }
  .film-controls { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; padding-top: 12px; }
  .film-status { font-size: 13px; }
  .film-status:empty { display: none; }
  .film-links { display: flex; flex-wrap: wrap; gap: 4px 16px; border-top: 1px solid var(--rule); margin-top: 16px; padding-top: 8px; font-size: 12px; }
  .film-links a { display: inline-flex; align-items: center; min-height: var(--he-touch-target); }
</style>
